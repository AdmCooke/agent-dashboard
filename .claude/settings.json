{
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "sales@synced": false,
    "marketing@synced": false,
    "small-business@synced": false,
    "design@synced": false,
    "figma@synced": false,
    "brightdata-plugin@synced": false,
    "searchfit-seo@synced": false,
    "productivity@synced": false,
    "cowork-plugin-management@synced": false,
    "browser-use@synced": false,
    "data@synced": false,
    "engineering@synced": false,
    "finance@synced": false,
    "legal@synced": false,
    "operations@synced": false,
    "superme@synced": false,
    "zapier@synced": false,
    "remotion@synced": false,
    "desktop-commander@synced": false,
    "mcp-tunnels@synced": false,
    "hostinger@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease* main)",
      "Bash(git push --force-with-lease* main *)",
      "Bash(git push --force-with-lease* HEAD:main*)",
      "Bash(git push --force-with-lease* *:main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-force-push.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-force-push.sh"
          }
        ]
      }
    ]
  }
}
